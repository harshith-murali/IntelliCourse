# Server Configuration
PORT=8000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@host-db.op3zap5.mongodb.net/lms_database

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Configuration (for emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# Stripe Configuration (for payments)
STRIPE_SECRET_KEY=sk_test_abc
STRIPE_WEBHOOK_SECRET=whsec_abc

# File Upload Configuration
MAX_FILE_SIZE=5242880 # 5MB in bytes
UPLOAD_PATH=./uploads

# Security Configuration
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW=15 # in minutes
RATE_LIMIT_MAX=100 # max requests per window

RAZORPAY_KEY_ID=rzp_test_abc
RAZORPAY_KEY_SECRET=5m5lCr3abc

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_lms_media_bucket_name

# Claude AI Configuration
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_TIMEOUT_MS=20000

# CloudFront Configurations (Optional fallback to S3 Presigned URLs if not defined)
CLOUDFRONT_DOMAIN_NAME=https://your-cloudfront-id.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=K3AAAAAAEXAMPLE
CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
